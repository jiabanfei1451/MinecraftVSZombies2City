config_version=5

[application]

config/name="MinecraftVSZombies2 City"
config/name_localized={
"ch_CN": "MinecraftVSZombies2 City"
}
config/version="beta0.1.3"
run/main_scene="uid://cff7if8145pjk"
config/use_custom_user_dir=true
config/custom_user_dir_name="jiabanfei/MVZ2_City"
config/features=PackedStringArray("4.7", "C#", "Mobile")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=10000
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="uid://yvjefvjdokp5"
config/windows_native_icon="res://2/Icon/City2.ico"

[autoload]

AudioList="*uid://yt638ulpwvil"
MuiscEngine="*uid://c7jdr8lln46bu"
CommandEdit="*uid://hpvvup1148jw"
CardData="*uid://cpmqdooq874b3"

[display]

window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
mouse_cursor/custom_image="uid://b0cg0w4pc066j"
display_server/stretch/scale_mode="integer"
window/version="beta0.1.3"

[dotnet]

project/assembly_name="MinecraftVSZombies2 City"
project/emulate_touch_from_mouse=true

[editor_plugins]

enabled=PackedStringArray("res://addons/butter_and_debug/plugin.cfg", "res://addons/save_or_load_data/plugin.cfg", "res://addons/touch/plugin.cfg")

[file_customization]

folder_colors={
"res://Script/": "green",
"res://Sound/": "teal",
"res://UI/": "orange",
"res://图片/": "gray",
"res://脚本/": "green"
}

[filesystem]

